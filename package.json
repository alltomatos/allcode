{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "allcode",
  "description": "AI-powered development tool",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --cwd packages/allcode --conditions=browser src/index.ts",
    "dev:desktop": "bun --cwd packages/desktop dev",
    "dev:local": "bun --cwd packages/desktop dev:local",
    "dev:web": "bun --cwd packages/app dev",
    "dev:console": "ulimit -n 10240 2>/dev/null; bun run --cwd packages/console/app dev",
    "dev:panel": "bun run --cwd packages/panel dev",
    "dev:stats": "bun sst shell --stage=production -- bun run --cwd packages/stats/app dev",
    "dev:storybook": "bun --cwd packages/storybook storybook",
    "lint": "oxlint",
    "typecheck": "bun turbo typecheck",
    "upgrade-opentui": "bun run script/upgrade-opentui.ts",
    "postinstall": "bun run --cwd packages/core fix-node-pty",
    "prepare": "husky",
    "random": "echo 'Random script'",
    "sso": "aws sso login --sso-session=opencode --no-browser",
    "translate:app": "bun run script/translate-app.ts",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/console/*",
      "packages/stats/*",
      "packages/sdk/js",
      "packages/slack"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.1.5",
      "@effect/platform-node": "4.1.5",
      "@effect/sql-sqlite-bun": "4.1.5",
      "@npmcli/arborist": "10.0.5",
      "@types/bun": "1.4.5",
      "@types/cross-spawn": "6.0.6",
      "@octokit/rest": "22.0.1",
      "@hono/standard-validator": "0.4.1",
      "@hono/zod-validator": "0.9.1",
      "@opentui/core": "0.9.7",
      "@opentui/keymap": "0.9.7",
      "@opentui/solid": "0.9.7",
      "@tanstack/solid-virtual": "3.13.53",
      "@shikijs/stream": "4.6.0",
      "ulid": "3.0.2",
      "@kobalte/core": "0.13.14",
      "@corvu/drawer": "0.2.4",
      "@types/luxon": "3.7.6",
      "@types/node": "26.6.6",
      "@types/semver": "7.8.0",
      "@tsconfig/node22": "22.0.7",
      "@tsconfig/bun": "1.0.12",
      "@cloudflare/workers-types": "5.20261120.1",
      "@openauthjs/openauth": "0.4.3",
      "@pierre/diffs": "1.6.4",
      "opentui-spinner": "0.0.7",
      "@solid-primitives/storage": "5.0.0",
      "@tailwindcss/vite": "4.3.5",
      "diff": "9.0.0",
      "dompurify": "3.4.18",
      "drizzle-kit": "1.0.0-rc.5",
      "drizzle-orm": "1.0.0-rc.5",
      "effect": "4.1.5",
      "ai": "7.0.177",
      "cross-spawn": "7.0.6",
      "hono": "4.13.19",
      "hono-openapi": "1.6.0",
      "fuzzysort": "4.0.2",
      "luxon": "3.7.2",
      "marked": "18.2.1",
      "marked-shiki": "1.2.1",
      "remend": "1.5.0",
      "@playwright/test": "1.65.1",
      "semver": "7.8.6",
      "typescript": "7.0.2",
      "@typescript/native-preview": "7.0.0-dev.20260707.2",
      "zod": "4.6.7",
      "remeda": "2.62.2",
      "sst": "4.17.2",
      "shiki": "4.6.0",
      "solid-list": "0.3.0",
      "tailwindcss": "4.3.5",
      "vite": "8.3.8",
      "@solidjs/meta": "2.0.0",
      "@solidjs/router": "2.0.1",
      "@solidjs/start": "https://pkg.pr.new/@solidjs/start@dfb2020",
      "@sentry/solid": "11.15.0",
      "@sentry/vite-plugin": "11.15.0",
      "solid-js": "2.0.3",
      "solid-sonner": "1.0.0",
      "vite-plugin-solid": "2.11.17",
      "@lydell/node-pty": "1.2.0-beta.18"
    }
  },
  "devDependencies": {
    "@actions/artifact": "5.0.1",
    "@tsconfig/bun": "catalog:",
    "@types/mime-types": "3.0.1",
    "@typescript/native-preview": "catalog:",
    "glob": "14.0.6",
    "husky": "9.1.7",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.10.1",
    "semver": "7.8.6",
    "sst": "catalog:",
    "turbo": "2.10.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1173.0",
    "@allcode/plugin": "workspace:*",
    "@allcode/script": "workspace:*",
    "@allcode/sdk": "workspace:*",
    "heap-snapshot-toolkit": "1.1.3",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alltomatos/allcode"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "node-pty",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "tree-sitter-powershell",
    "web-tree-sitter",
    "electron"
  ],
  "overrides": {
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/solid": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "seroval": "1.7.5",
    "tar": "7.5.22",
    "proxy-addr": "2.0.8",
    "fast-xml-parser": "5.11.2",
    "dompurify": "3.4.17",
    "follow-redirects": "1.16.2",
    "socket.io-parser": "4.2.7",
    "qs": "6.17.1",
    "electron": "42.11.18",
    "builder-util-runtime": "9.7.1",
    "fastify": "5.12.7",
    "happy-dom": "20.14.6",
    "astro": "5.18.2",
    "storybook": "10.6.5",
    "@storybook/addon-vitest": "10.6.5"
  },
  "patchedDependencies": {
    "@dnd-kit/dom@0.5.0": "patches/@dnd-kit%2Fdom@0.5.0.patch",
    "@ff-labs/fff-bun@0.9.3": "patches/@ff-labs%2Ffff-bun@0.9.3.patch",
    "@solidjs/start@2.0.0-devinxi.0": "patches/@solidjs%2Fstart@2.0.0-devinxi.0.patch",
    "@npmcli/agent@4.0.2": "patches/@npmcli%2Fagent@4.0.2.patch",
    "@silvia-odwyer/photon-node@0.3.4": "patches/@silvia-odwyer%2Fphoton-node@0.3.4.patch",
    "@standard-community/standard-openapi@0.2.9": "patches/@standard-community%2Fstandard-openapi@0.2.9.patch",
    "solid-js@1.9.10": "patches/solid-js@1.9.10.patch",
    "@ai-sdk/xai@3.0.102": "patches/@ai-sdk%2Fxai@3.0.102.patch",
    "@ai-sdk/mistral@3.0.51": "patches/@ai-sdk%2Fmistral@3.0.51.patch",
    "gcp-metadata@8.1.2": "patches/gcp-metadata@8.1.2.patch",
    "pacote@21.5.0": "patches/pacote@21.5.0.patch",
    "@ai-sdk/google@3.0.73": "patches/@ai-sdk%2Fgoogle@3.0.73.patch",
    "@pierre/trees@1.0.0-beta.4": "patches/@pierre%2Ftrees@1.0.0-beta.4.patch",
    "@modelcontextprotocol/sdk@1.29.0": "patches/@modelcontextprotocol%2Fsdk@1.29.0.patch",
    "effect@4.0.0-beta.83": "patches/effect@4.0.0-beta.83.patch",
    "@tanstack/virtual-core@3.17.3": "patches/@tanstack%2Fvirtual-core@3.17.3.patch",
    "@ai-sdk/openai-compatible@2.0.41": "patches/@ai-sdk%2Fopenai-compatible@2.0.41.patch",
    "@ai-sdk/groq@3.0.31": "patches/@ai-sdk%2Fgroq@3.0.31.patch"
  }
}
