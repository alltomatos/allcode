    "electron": "42.3.3",
    "electron-builder": "26.15.2",
    "electron-vite": "^5",
    "solid-js": "catalog:",
    "sury": "11.0.0-alpha.4",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "zod-openapi": "5.4.6"
  },
