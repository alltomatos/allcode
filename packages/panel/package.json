{
  "name": "@allcode/panel",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "predev": "bun ./script/fix-solid-start-windows.ts",
    "dev": "vite dev",
    "prebuild": "bun ./script/fix-solid-start-windows.ts",
    "build": "vite build",
    "prebuild:cloudflare": "bun ./script/fix-solid-start-windows.ts",
    "build:cloudflare": "vite build && bun ./script/finalize.ts",
    "bump": "bun ./script/bump.ts",
    "bump:patch": "bun ./script/bump.ts patch",
    "bump:minor": "bun ./script/bump.ts minor",
    "bump:major": "bun ./script/bump.ts major",
    "deploy": "bun run build:cloudflare && wrangler d1 migrations apply allcode-panel --remote --config wrangler.jsonc && wrangler deploy",
    "deploy:bump": "bun run bump && bun run deploy",
    "db:migrate:local": "wrangler d1 migrations apply allcode-panel --local --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply allcode-panel --remote --config wrangler.jsonc",
    "preview": "wrangler dev",
    "start": "vite start",
    "admin:reset-password": "bun ./script/reset-admin-password.ts",
    "admin:reseed": "bun ./script/reseed-admin-password.ts",
    "test": "bun test",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "catalog:",
    "@solidjs/start": "catalog:",
    "nitro": "3.0.1-alpha.2",
    "postgres": "4.1.1",
    "solid-js": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "wrangler": "4.152.0"
  }
}
